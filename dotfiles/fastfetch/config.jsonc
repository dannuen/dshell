{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "blue" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "os" },
    { "type": "kernel", "key": "kernel" },
    { "type": "wm", "key": "wm" },
    { "type": "shell", "key": "shell" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu", "key": "cpu" },
    { "type": "gpu", "key": "gpu" },
    { "type": "memory", "key": "mem" },
    { "type": "uptime", "key": "up" },
    "break",
    "colors"
  ]
}
